# Copy to .env (git-ignored) for local builds, or set these in Netlify > Site settings > Environment variables.
# A per-tenant file .env.<tenant> (e.g. .env.labella) is also read, so you can keep several clients side by side.

TENANT=thalasso

# Optional overrides. If unset, the "supabase" block of tenants/<TENANT>/tenant.json is used.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=eyJ...   # anon (public) key ONLY. Never put the service_role key in this project.
