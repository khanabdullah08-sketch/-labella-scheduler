.DS_Store
node_modules/
dist/
# test/db has its own package.json (PGlite, an in-process Postgres used only by tests)
!test/db/package.json
!test/db/package-lock.json

# Local environment files (never commit real values). .env.example is the template.
.env
.env.*
!.env.example

# Client-supplied source material (large binaries) stays on disk only
client_inputs/*.pdf
